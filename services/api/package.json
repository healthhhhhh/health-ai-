{
  "name": "@healthmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "HealthMate shared API (NestJS) \u2014 auth, health profile, AI gateway, safety, documents, health data",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch & node --env-file-if-exists=../../.env --watch dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node dist/demo.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "db:migrate": "node --env-file-if-exists=../../.env dist/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@healthmate/safety": "0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.9",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
