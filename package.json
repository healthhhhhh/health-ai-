{
  "name": "healthmate",
  "version": "0.1.0",
  "private": true,
  "description": "HealthMate — AI Health Companion (iOS + web monorepo)",
  "workspaces": [
    "apps/web",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "npm run build -w @healthmate/design-tokens",
    "tokens:check": "npm run check -w @healthmate/design-tokens",
    "dev": "npm run dev -w @healthmate/web",
    "build": "npm run build -w @healthmate/web",
    "lint": "npm run lint -w @healthmate/web",
    "safety:build": "npm run build -w @healthmate/safety",
    "safety:export": "npm run export-rules -w @healthmate/safety",
    "safety:check": "npm run check -w @healthmate/safety",
    "api:dev": "npm run build -w @healthmate/safety && npm run dev -w @healthmate/api",
    "pretypecheck": "npm run safety:build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run safety:build",
    "test": "npm run tokens:check && npm run safety:check && npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @healthmate/web"
  }
}
