# HealthMate web (Next.js).
#
# Phase 1 default: Preview mode — the app runs on a built-in sample account,
# no backend needed. Set HEALTHMATE_DATA_SOURCE=api (and the URL) to use the API.
HEALTHMATE_DATA_SOURCE=preview
# HEALTHMATE_API_URL=http://localhost:4000/v1
#
# The browser never talks to the API or Supabase directly: server components,
# actions and route handlers call the API with the person's session.
# Never put model/provider API keys or the Supabase secret key in this app.
#
# Support address on the Help page (restricted accounts are sent there). Required before launch.
# HEALTHMATE_SUPPORT_EMAIL=support@example.com
