# Data source for the web client.
#   mock — built-in sample data (default until the backend exists)
#   api  — the shared HealthMate API at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
# Never put model/provider API keys in this app. AI calls go through the backend AI Gateway.
