# HealthMate API (services/api) — copy to .env and fill in. NEVER commit .env.
# Everything here is SERVER-SIDE ONLY. iOS and web never receive the secret key,
# the database URL or any AI provider key.
#
# Leave everything empty for local development: the API then uses an embedded
# PostgreSQL (PGlite with pgvector), local disk storage, local accounts and
# in-process jobs. Set the Supabase values to use Supabase.

NODE_ENV=development
PORT=4000
# Public URL of this API (used for local signed file links).
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed to call the API from a browser (the web app talks server-to-server).
CORS_ORIGINS=

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. URL like https://<project-ref>.supabase.co
SUPABASE_URL=
# sb_publishable_…  (used server-side for Auth sign-in/refresh calls)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_…  SECRET — server only. Bypasses Row Level Security. Rotate if it is ever exposed.
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy shared JWT secret; new projects verify via JWKS.
SUPABASE_JWT_SECRET=
# Postgres connection. Dashboard → Connect → Transaction pooler (port 6543), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Supabase's CA certificate (PEM, from Dashboard → Database → SSL) to verify TLS.
DATABASE_CA_CERT=
# Apply migrations at startup (default: true in development, false in production — run `npm run db:migrate -w @healthmate/api`).
MIGRATE_ON_START=
# Web page that sets the new password after a reset email (must be in Auth → URL Configuration → Redirect URLs).
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Adapters (defaults follow from the values above).
#   AUTH_PROVIDER=local|supabase        STORAGE_PROVIDER=local|supabase
#   EMBEDDINGS_PROVIDER=supabase|hash|none   (hash is for development only)
AUTH_PROVIDER=
STORAGE_PROVIDER=
EMBEDDINGS_PROVIDER=
# Shared secret with the `embed` Edge Function (≥ 24 chars). Also set it with:
#   supabase secrets set EMBED_FUNCTION_SECRET=…
EMBED_FUNCTION_SECRET=

# ── AI Gateway ─────────────────────────────────────────────────────────────
# SECRET — server only. Optional: without it the assistant says it's unavailable (it never improvises).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# anthropic | development | none. Default: anthropic when ANTHROPIC_API_KEY is set, otherwise none.
# development = offline, free, no key: scripted answers that list the health context retrieval
# selected (no model is called; clients show their demo notice). Refused in production.
AI_PROVIDER=
# Per-task routing (optional): task=provider[:model][@effort], comma-separated. Tasks: health_chat,
# complex_health, report_analysis, image_analysis, task_generation, summarization. Unrouted tasks
# use AI_PROVIDER. Example: complex_health=anthropic:claude-opus-5-5@high,summarization=anthropic:claude-haiku-4-5@low
AI_ROUTES=
# Price overrides, USD per million tokens: model=input/output[/cacheRead/cacheWrite]. Built-in prices:
# Anthropic list prices (see PRICES_EFFECTIVE_DATE in services/api/src/modules/ai/ai.pricing.ts).
# A paid model without a price is refused (startup fails if a route names one).
AI_PRICES=
# Internal monthly AI cost limit per person, USD (0 = no limit). Never shown to people; urgent-symptom
# answers and emergency guidance are never blocked by it.
AI_MONTHLY_USER_BUDGET_USD=5
# Longest wait for one AI call (ms). A timed-out call is charged its reserved worst case.
AI_REQUEST_TIMEOUT_MS=240000

# ── Google sign-in (Phase 2D, free) ────────────────────────────────────────
# OAuth client IDs from Google Cloud (iOS and/or web), comma-separated. Public identifiers,
# not secrets. Empty: "Continue with Google" answers "not available". See docs/phase2d-plan.md.
GOOGLE_CLIENT_IDS=

# ── Push notifications (Phase 2D) ──────────────────────────────────────────
# log | apns | none. Default: log in development (nothing is sent), none in production.
PUSH_PROVIDER=
# SECRET — 32 bytes, base64 (openssl rand -base64 32). Encrypts stored device tokens.
# Development: a random per-process key when empty. Production: required to store tokens.
PUSH_TOKEN_KEY=
# APNs (needs the paid Apple Developer Program; only read when PUSH_PROVIDER=apns).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# SECRET — the .p8 key contents (PEM; \n escapes allowed).
APNS_PRIVATE_KEY=

# ── Redis (rate limits shared across instances + BullMQ jobs) ─────────────
# e.g. rediss://default:<password>@<host>:6379 . Without it both run in-process.
REDIS_URL=
# Run background jobs inside the API process too (otherwise run `npm run worker -w @healthmate/api`).
RUN_WORKER_IN_API=

# ── Local-only settings ────────────────────────────────────────────────────
# HMAC secret for local accounts and local signed file links (≥ 32 chars). Required
# in production only if AUTH_PROVIDER=local (not recommended).
JWT_SECRET=
STORAGE_DIR=.data/uploads
PGLITE_DIR=

# ── Monitoring ─────────────────────────────────────────────────────────────
# Error reporting; events must be scrubbed of health content.
SENTRY_DSN=

# Retention of operational logs (no health content), in days; 0 = keep forever.
# Health data never expires automatically (docs/health-memory-architecture.md §6).
AUDIT_LOG_RETENTION_DAYS=400
AI_USAGE_RETENTION_DAYS=400
SAFETY_EVENT_RETENTION_DAYS=730
